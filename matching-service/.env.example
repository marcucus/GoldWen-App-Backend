# GoldWen Matching Service - Environment Configuration

# API Authentication
# SECURITY (Phase 0.10): must be set to a real, unique secret — this must
# match MATCHING_SERVICE_API_KEY in the main-api's own .env. There is no
# default; the service refuses to start without this set.
API_KEY=change_me_shared_secret_with_main_api

# Comma-separated list of browser origins allowed to call this service
# directly (leave empty — this is an internal, server-to-server API with no
# legitimate browser callers).
ALLOWED_ORIGINS=

# Database Configuration (PostgreSQL)
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://goldwen_user:goldwen_password@localhost:5432/goldwen_db

# Redis Configuration (Optional - for caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
CACHE_TTL=3600
CACHE_ENABLED=true

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Logging
LOG_LEVEL=INFO
